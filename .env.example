# Never commit a populated .env file. Generate JWT_SECRET_KEY with a cryptographically
# secure password generator (at least 32 bytes) and keep provider credentials private.
JWT_SECRET_KEY=replace-with-a-strong-random-secret
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/rakshak
REDIS_URL=redis://localhost:6379/0
DEMO_GATE_PASSWORD=change-this-demo-password
BOOTSTRAP_DEMO_ACCOUNTS=false
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSPHRASE=
CORS_ORIGINS=http://localhost:3000,http://localhost:3005,https://stail-rakshakai.vercel.app

# S3 Storage Configuration
S3_BUCKET_NAME=fasal-rakshak-evidence
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
LOCAL_STORAGE_DIR=./storage

# Video Processing & Quality Configuration
QUALITY_BLUR_THRESHOLD=80.0
MIN_USABLE_FRAMES_THRESHOLD=5
MIN_VIDEO_DURATION_SECONDS=10.0
MAX_VIDEO_DURATION_SECONDS=30.0
MAX_UPLOAD_BYTES=104857600
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.m4v,.avi
CELERY_CPU_QUEUE=cpu_processing

# LLM Advisor (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Frontend & Application Settings
ENVIRONMENT=production
PROJECT_NAME=Fasal Rakshak AI
API_V1_STR=/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000
