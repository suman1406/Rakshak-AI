# Required - Database & Cache
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/dbname?sslmode=require
REDIS_URL=redis://host:6379/0
JWT_SECRET_KEY=generate-a-secure-random-string

# Optional - LLM Advisor (Groq)
GROQ_API_KEY=

# Video Processing Configuration
QUALITY_BLUR_THRESHOLD=80.0
MIN_USABLE_FRAMES_THRESHOLD=5
MIN_VIDEO_DURATION_SECONDS=10.0
MAX_VIDEO_DURATION_SECONDS=30.0
MAX_UPLOAD_BYTES=104857600
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.m4v,.avi
LOCAL_STORAGE_DIR=/app/storage
CELERY_CPU_QUEUE=cpu_processing

# Application Settings
ENVIRONMENT=production
PROJECT_NAME=Fasal Rakshak AI
API_V1_STR=/api/v1

# Legacy/S3 Storage (optional)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MODEL_PATH=models/soybean.pt

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000